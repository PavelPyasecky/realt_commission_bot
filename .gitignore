# ----------------------------------------------------------------------
# 1. Python & Runtime
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Distribution / Packaging
dist/
build/
*.egg-info/
.eggs/

# ----------------------------------------------------------------------
# 2. Virtual Environments
# ----------------------------------------------------------------------
# Обычно называются venv, env или .venv
venv/
env/
.venv/
.Python

# ----------------------------------------------------------------------
# 3. Environment Variables & Secrets (CRITICAL)
# ----------------------------------------------------------------------
# Никогда не коммитим файлы с реальными ключами!
.env
.env.prod
.env.test
.env.local

# Но мы хотим оставить пример конфигурации
!.env.example

# ----------------------------------------------------------------------
# 4. Logs & Databases
# ----------------------------------------------------------------------
*.log
logs/

# Если используешь SQLite локально для тестов
*.sqlite
*.sqlite3
*.db

# ----------------------------------------------------------------------
# 5. IDE & Editor Settings
# ----------------------------------------------------------------------
# JetBrains (PyCharm)
.idea/

# VS Code
.vscode/
*.code-workspace

# macOS
.DS_Store

# ----------------------------------------------------------------------
# 6. Docker & Local Mounts
# ----------------------------------------------------------------------
# Игнорируем локальные данные БД, если они смонтированы через docker-compose volumes
pg_data/
redis_data/

# ----------------------------------------------------------------------
# 7. Testing & Quality Tools
# ----------------------------------------------------------------------
# Pytest
.pytest_cache/

# Coverage reports
.coverage
htmlcov/
coverage.xml

# Type Checking (MyPy)
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / Linters
.ruff_cache/